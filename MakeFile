# --- Макроси ---

CC = gcc
# Компілятор C

AR = ar
# Утиліта для створення статичних бібліотек

ARFLAGS = rcs
# r : додати або замінити файли в бібліотеці
# c : створити бібліотеку, якщо її немає
# s : створити індекс символів бібліотеки

CFLAGS = -Wall -Wextra
# -Wall   : показувати основні попередження
# -Wextra : показувати додаткові попередження


all: binary


# --- Виконуваний файл ---

# Залежить від main.o та статичної бібліотеки libfunctions.a
# Підключає статичну бібліотеку безпосередньо під час компонування
binary: main.o libfunctions.a
	$(CC) -o binary main.o libfunctions.a


# --- Об'єктний файл main.c ---

# Залежить від main.c та functions.h
# -c : тільки компіляція, без компонування
main.o: main.c functions.h
	$(CC) $(CFLAGS) -c main.c


# --- Статична бібліотека ---

# Залежить від об'єктного файлу functions.o
# $(AR) : виклик утиліти створення бібліотек
# $(ARFLAGS) : параметри створення бібліотеки
libfunctions.a: functions.o
	$(AR) $(ARFLAGS) libfunctions.a functions.o


# --- Об'єктний файл functions.c ---

# Залежить від functions.c та functions.h
# -c : тільки компіляція, без компонування
functions.o: functions.c functions.h
	$(CC) $(CFLAGS) -c functions.c


# --- Видалення ---

# rm -f : видалити файли без помилки, якщо їх немає
clean:
	rm -f *.o *.a binary binary.exe dest_file.txt test_3.bin


# - PHONY : цілі, які не є назвами реальних файлів
.PHONY: all clean