# --- Макроси ---

CC = gcc
# Компілятор C

CFLAGS = -Wall -Wextra
# -Wall   : показувати основні попередження
# -Wextra : показувати додаткові попередження


all: binary


# --- Виконуваний файл ---

# Залежить від main.o та динамічної бібліотеки libfunctions.dll
# -L. : каталог з бібліотеками — поточний каталог
# -lfunctions : підключити бібліотеку libfunctions
# -Wl,... : передати параметр безпосередньо компонувальнику
binary: main.o libfunctions.dll
	$(CC) -o binary main.o -L. -lfunctions


# --- Об'єктний файл main.c ---

# Залежить від main.c та functions.h
# -c : тільки компіляція, без компонування
main.o: main.c functions.h
	$(CC) $(CFLAGS) -c main.c


# --- Динамічна бібліотека ---

# Залежить від об'єктного файлу functions.o
# -shared : створити динамічну бібліотеку
# -o : задати назву вихідного файлу
# --out-implib : створити імпортну бібліотеку для компонування з DLL
libfunctions.dll: functions.o
	$(CC) -shared -o libfunctions.dll functions.o -Wl,--out-implib,libfunctions.dll.a


# --- Об'єктний файл functions.c ---

# Залежить від functions.c та functions.h
# -c : тільки компіляція, без компонування
functions.o: functions.c functions.h
	$(CC) $(CFLAGS) -c functions.c


# --- Видалення ---

# rm -f : видалити файли без помилки, якщо їх немає
clean:
	rm -f *.o *.dll *.a binary binary.exe dest_file.txt test_3.bin


# - PHONY : цілі, які не є назвами реальних файлів
.PHONY: all clean